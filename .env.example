# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FINMIND_API_TOKEN (或 FINMIND_TOKEN): FinMind 999元付費 VIP 會員金鑰
# 在 Google AI Studio 的 Secrets 面板中新增此變數，系統後端自動載入，所有使用者免手動輸入即可享有 VIP 高速即時行情！
FINMIND_API_TOKEN="MY_FINMIND_TOKEN"

# ==========================================
# GROQ 免費高速算力金鑰 (10 組 Token 輪詢池)
# 模型: llama-3.3-70b-versatile (免費、極速、無延遲)
# ==========================================
GROQ_API_KEY="gsk_..."
GROQ_API_KEY_1="gsk_..."
GROQ_API_KEY_2="gsk_..."
GROQ_API_KEY_3="gsk_..."
GROQ_API_KEY_4="gsk_..."
GROQ_API_KEY_5="gsk_..."
GROQ_API_KEY_6="gsk_..."
GROQ_API_KEY_7="gsk_..."
GROQ_API_KEY_8="gsk_..."
GROQ_API_KEY_9="gsk_..."
GROQ_API_KEY_10="gsk_..."

# ==========================================
# 管理系統最高超級管理員 (SUPERUSER) 金鑰設定
# 可在 Google AI Studio Secrets 面板設定以下變數：
# ==========================================
ADMIN_SUPERUSER_NAME="程瑋翔"
ADMIN_SUPERUSER_PASSWORD="3226"
SUPERUSER_NAME="程瑋翔"
SUPERUSER_PASSWORD="3226"
VITE_SUPERUSER_NAME="程瑋翔"
VITE_SUPERUSER_PASSWORD="3226"
